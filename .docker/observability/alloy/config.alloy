discovery.docker "tubester_containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "tubester_logs" {
  targets = discovery.docker.tubester_containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(tubester-api|tubester-worker)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.+)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/tubester-api"
    target_label  = "service"
    replacement   = "tubester-api"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/tubester-worker"
    target_label  = "service"
    replacement   = "tubester-worker"
  }

  rule {
    target_label = "environment"
    replacement  = "local-prodlike"
  }

  rule {
    target_label = "app"
    replacement  = "tubester"
  }
}

loki.source.docker "tubester_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.tubester_logs.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
