{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TubesterDb": "Host=localhost;Port=5432;Database=tubester;Username=app;Password=devpassword"
  },
  "Observability": {
    "Seq": {
      "Enabled": true,
      "Url": "http://localhost:5341"
    }
  },
  "Serilog": {
    "Enabled": false,
    "WriteTo": [
      {
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.ConsoleTheme::None, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] [{Environment}] {Message:lj} {Properties:j}{NewLine}{Exception}"        }
      }
    ]
  }
}
