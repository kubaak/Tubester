{
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http": "Warning",
        "Hangfire": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.ConsoleTheme::None, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] [{Environment}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TubesterDb": ""
  },
  "VideoListing": {
    "DefaultPageSize": 30,
    "MaxPageSize": 100
  },
  "ReplyListing": {
    "DefaultPageSize": 3,
    "MaxPageSize": 100
  },
  "GoogleAuth": {
    "AllowedEmailDomains": [],
    "AllowedEmails": [],
    "RequireEmailVerification": true,
    "ClientId": "dummy",
    "ClientSecret": "dummy"
  },
  "Observability": {
    "Enabled": true,
    "Prometheus": {
      "Enabled": true,
      "ExposePublicly": false
    },
    "Seq": {
      "Enabled": false,
      "Url": "http://localhost:5341"
    },
    "BusinessMetrics": {
      "RefreshIntervalSeconds": 60
    }
  }
}
