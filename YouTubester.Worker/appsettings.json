{
  "ConnectionStrings": {
    "YouTubesterDb": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Hangfire": "Warning"
    }
  },
  "Worker": {
    "MaxDraftsPerRun": 25,
    "IntervalSeconds": 600
  },
  "AI": {
    "Enable": true,
    "Provider": "ollama",
    "Endpoint": "http://localhost:11434",
    "Model": "gemma3:12b",
    "ReplaceTitle": true,
    "ApplyDescription": true,
    "ReplyToComments": true,
    "MaxRepliesPerRun": 10,
    "DryRunReplies": false
  }
}
